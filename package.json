{
  "name": "inventory-app",
  "version": "1.0.0",
  "description": "Simple CAP app with DB-level validation, actions and functions",
  "dependencies": {
    "@cap-js/hana": "^2",
    "@cap-js/sqlite": "^3",
    "@sap/cds": "^10",
    "express": "^4",
    "@sap/xssec": "^4"
  },
  "devDependencies": {
    "@sap/cds-dk": "^10",
    "cds-plugin-ui5": "^0.17.0"
  },
  "scripts": {
    "start": "cds-serve",
    "watch": "cds watch",
    "watch-productsapp": "cds watch --open inventory.productsapp/index.html?sap-ui-xx-viewCache=false --livereload false"
  },
  "cds": {
    "requires": {
      "db": {
        "kind": "sqlite",
        "credentials": {
          "url": ":memory:"
        }
      },
      "[production]": {
        "db": {
          "kind": "hana"
        },
        "auth": "xsuaa"
      },
      "destinations": true,
      "html5-repo": true,
      "workzone": true
    }
  },
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/productsapp",
    "app/productsapp",
    "app/productsapp"
  ]
}

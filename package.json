{
  "name": "inventory-app",
  "version": "1.0.0",
  "description": "Simple CAP app with DB-level validation, actions and functions",
  "dependencies": {
    "@sap/cds": "^10",
    "@cap-js/sqlite": "^3",
    "express": "^4"
  },
  "devDependencies": {
    "@sap/cds-dk": "^10",
    "cds-plugin-ui5": "^0.17.0"
  },
  "scripts": {
    "start": "cds-serve",
    "watch": "cds watch",
    "watch-productsapp": "cds watch --open inventory.productsapp/index.html?sap-ui-xx-viewCache=false --livereload false"
  },
  "cds": {
    "requires": {
      "db": {
        "kind": "sqlite",
        "credentials": {
          "url": ":memory:"
        }
      }
    }
  },
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/productsapp",
    "app/productsapp",
    "app/productsapp"
  ]
}
